    "test:watch": "vitest",
    "optimize:portrait": "node scripts/optimize-portrait.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.2.1",
    "astro": "^4.16.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
