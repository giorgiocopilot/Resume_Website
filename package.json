{
  "name": "giorgio-tsoupis-resume",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Static, accessible, privacy-preserving one-page professional résumé (Astro + TypeScript + Zod).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/postbuild-csp.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
