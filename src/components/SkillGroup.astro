---
/**
 * SkillGroup.astro — one skill category rendered as a card with a chip list.
 */
import type { SkillGroup } from "../schemas/resume.schema";

interface Props {
  group: SkillGroup;
}
const { group }: Props = Astro.props;
---

<article class="card">
  <h3>{group.category}</h3>
  <ul class="chips" aria-label={`${group.category} skills`}>
    {group.skills.map((skill) => (
      <li class="chip">{skill}</li>
    ))}
  </ul>
</article>
