---
/**
 * ContactActions.astro
 * ----------------------------------------------------------------------------
 * The two primary contact buttons + the labelled external links.
 *
 * Each button is a REAL anchor whose href is a genuine mailto:/wa.me URL, so:
 *   • With JS off, clicking still opens the user's email/WhatsApp app.
 *   • With JS on, reveal-resume.ts additionally reveals the full résumé.
 * We never preventDefault (no scroll hijack) and never claim the message was
 * sent — the browser cannot verify delivery.
 *
 * Props let the same component render in the hero and in the sticky mobile bar.
 */
import { resume } from "../data/resume.data";
import { buildMailtoUrl, buildWhatsAppUrl } from "../scripts/contact-links";

interface Props {
  /** "hero" (full, with labels + note) or "bar" (compact, sticky mobile). */
  variant?: "hero" | "bar";
}
const { variant = "hero" }: Props = Astro.props;

const { contact } = resume;
const mailto = buildMailtoUrl(
  contact.email,
  contact.emailSubject,
  contact.emailBody,
);
const whatsapp = buildWhatsAppUrl(contact.whatsappNumber, contact.whatsappMessage);

const waLabel =
  variant === "bar" ? "WhatsApp" : "Send WhatsApp and view full résumé";
const emailLabel =
  variant === "bar" ? "Email" : "Send email and view full résumé";
---

<div class={variant === "bar" ? "mobile-bar" : "actions"}>
  <a
    class="btn btn--primary"
    href={whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    data-reveal-trigger
    aria-describedby={variant === "hero" ? "contact-privacy" : undefined}
  >
    <!-- WhatsApp glyph (inline SVG, decorative) -->
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 2.1.55 4.1 1.6 5.9L2 22l4.35-1.14a9.9 9.9 0 0 0 5.69 1.77h.01c5.46 0 9.9-4.45 9.9-9.9C21.95 6.45 17.5 2 12.04 2Zm0 18.1h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-2.58.68.69-2.52-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.8-.23-.09-.4-.13-.56.13-.17.25-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42l-.48-.01c-.16 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/>
    </svg>
    <span>{waLabel}</span>
  </a>

  <a
    class="btn btn--email"
    href={mailto}
    data-reveal-trigger
    aria-describedby={variant === "hero" ? "contact-privacy" : undefined}
  >
    <!-- Envelope glyph (inline SVG, decorative) -->
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </svg>
    <span>{emailLabel}</span>
  </a>
</div>

{
  variant === "hero" && (
    <p class="privacy-note" id="contact-privacy">
      Clicking a button opens your own WhatsApp or email app with a pre-filled
      message and reveals the remaining résumé sections on this page. It does
      <strong> not</strong> send anything automatically — you choose whether to
      send. No tracking, cookies, or third-party scripts are used.
    </p>
  )
}
